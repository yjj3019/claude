{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "python scripts/hooks/record_test_run.py"}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "python scripts/hooks/verify_before_stop.py"}
        ]
      }
    ]
  }
}
